{
  "name": "loudness-lens",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:site": "vite --config site/vite.config.ts",
    "build:extension": "wxt build && wxt zip",
    "build:site": "npm run build:extension && vite build --config site/vite.config.ts && node scripts/package.mjs",
    "build": "npm run build:site",
    "test": "npm run build && npm run typecheck && npm run lint && vitest run && playwright test",
    "test:unit": "npm run build:extension && vitest run",
    "test:e2e": "npm run build && playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "9.36.0",
    "@playwright/test": "1.58.2",
    "@types/chrome": "0.0.287",
    "eslint": "9.36.0",
    "globals": "15.15.0",
    "typescript": "5.7.3",
    "typescript-eslint": "8.43.0",
    "vite": "6.4.3",
    "vitest": "3.2.7",
    "wxt": "0.21.4"
  }
}
